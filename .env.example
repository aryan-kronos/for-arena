# Public website URL. Use the final production origin without a trailing slash.
VITE_SITE_URL=https://example.com

# Supabase public browser configuration. The anon key is public by design;
# security must come from RLS. Never expose the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local/demo authentication. Disable in production after real Supabase users and
# roles are configured. Never treat the demo credentials as security.
VITE_ENABLE_DEMO_AUTH=true

# Optional server/edge lead endpoint. If Supabase is configured, the website can
# use the restricted anonymous insert policy instead.
VITE_PILOT_API_URL=

# Public contact actions
VITE_CONTACT_EMAIL=hello@example.com
VITE_WHATSAPP_URL=

# Pricing. Values are embedded at build time by Vercel.
VITE_PRICING_VISIBLE=false
VITE_PRICING_LABEL=Pilot pricing — subject to confirmation
VITE_SOFTWARE_PRICE=₹599 / month
VITE_PASS_PACK_PRICE=₹999 / 50 passes
VITE_COMBINED_PILOT_PRICE=₹1,999 pilot bundle

# Server-side build value used by scripts/generate-seo.mjs.
# Configure the same production origin in Vercel.
SITE_URL=https://example.com
